{
    "name": "justinholtweb/craft-rat",
    "description": "Track which users made edits to all content types on your Craft CMS site",
    "type": "craft-plugin",
    "version": "5.1.1",
    "keywords": [
        "craftcms",
        "cms",
        "craft",
        "audit",
        "edit tracking",
        "changelog"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-rat/issues",
        "source": "https://github.com/justinholtweb/craft-rat",
        "docs": "https://craft-rat.com"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.2.0",
        "codeception/module-asserts": "^3.0.0",
        "codeception/module-datafactory": "^3.0.0",
        "codeception/module-yii2": "^1.1.9",
        "fakerphp/faker": "^1.19.0",
        "league/factory-muffin": "^3.3.0",
        "phpunit/phpunit": "^10.5",
        "vlucas/phpdotenv": "^5.4.1"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\rat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\rat\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "codecept run",
        "test-unit": "codecept run unit",
        "test-integration": "codecept run integration"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "name": "Rat",
        "handle": "rat",
        "hasCpSettings": false,
        "hasCpSection": false,
        "class": "justinholtweb\\rat\\Plugin",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://craft-rat.com",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-rat/main/CHANGELOG.md",
        "description": "Track which users made edits to all content types on your Craft CMS site"
    }
}
