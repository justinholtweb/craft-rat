# Test-only database credentials. These point at the DDEV database container
# and are deliberately committed — they are not secrets and only ever address a
# throwaway schema that the test suite drops and recreates on every run.
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=test
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=root
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=
CRAFT_DB_DSN=mysql:host=db;port=3306;dbname=test

PRIMARY_SITE_URL=https://test.craftcms.test/
SECURITY_KEY=rat-plugin-test-suite-key
