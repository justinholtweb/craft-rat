{% if edits|length %}
    <div class="rat-recent-edits">
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'User'|t('rat') }}</th>
                    <th>{{ 'Element'|t('rat') }}</th>
                    <th>{{ 'Type'|t('rat') }}</th>
                    <th>{{ 'Action'|t('rat') }}</th>
                    <th>{{ 'Date'|t('rat') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for edit in edits %}
                    {% set user = edit.getUser() %}
                    {% set element = edit.getElement() %}
                    <tr>
                        <td>
                            {% if user %}
                                <div class="rat-user">
                                    <div class="rat-user-photo">
                                        {{ user.getThumbHtml(24)|raw }}
                                    </div>
                                    <a href="{{ user.cpEditUrl }}">{{ user.friendlyName }}</a>
                                </div>
                            {% else %}
                                <span class="light">{{ 'System'|t('rat') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set cpEditUrl = element and not element.trashed ? element.cpEditUrl : null %}
                            {% if cpEditUrl %}
                                <a href="{{ cpEditUrl }}">{{ edit.elementLabel }}</a>
                            {% else %}
                                <span class="light">{{ edit.elementLabel ?? 'Deleted'|t('rat') }}</span>
                                {% if element and element.trashed %}
                                    <span class="light">({{ 'in the trash'|t('rat') }})</span>
                                {% endif %}
                            {% endif %}
                            {% set summary = edit.getMoveSummary() %}
                            {% if summary %}
                                <div class="rat-history-attrs light">{{ summary }}</div>
                            {% endif %}
                        </td>
                        <td>
                            <span class="rat-type-badge">{{ edit.getElementTypeLabel() }}</span>
                        </td>
                        <td>
                            <span class="status {{ edit.getActionColor() }}" title="{{ edit.getActionLabel() }}"></span> {{ edit.getActionLabel() }}
                        </td>
                        <td>
                            <span title="{{ edit.dateCreated|datetime }}">
                                {{ edit.dateCreated|timestamp }}
                            </span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="light">{{ (deletionsOnly ? 'No deletions recorded yet.' : 'No edits recorded yet.')|t('rat') }}</p>
{% endif %}
