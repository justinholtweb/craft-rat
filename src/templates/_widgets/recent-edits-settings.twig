{% import '_includes/forms.twig' as forms %}

{{ forms.textField({
    label: 'Limit'|t('rat'),
    instructions: 'The maximum number of recent edits to display.'|t('rat'),
    id: 'limit',
    name: 'limit',
    value: widget.limit,
    size: 3,
    type: 'number',
    min: 1,
    max: 100,
}) }}

{{ forms.selectField({
    label: 'Show'|t('rat'),
    instructions: 'Deletions only turns the widget into a “who deleted this?” list, including elements deleted permanently.'|t('rat'),
    id: 'show',
    name: 'show',
    value: widget.show,
    options: [
        { label: 'All activity'|t('rat'), value: 'all' },
        { label: 'Deletions only'|t('rat'), value: 'deletions' },
    ],
}) }}
